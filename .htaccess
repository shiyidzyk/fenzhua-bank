# 粉爪银行 · 卡包 —— Apache / LiteSpeed 虚拟主机配置
# 用法：与 index.html 同目录上传；若面板里也开了 gzip，重复开启不会有副作用
# 说明：Nginx 服务器请改用 nginx.conf，本文件对 Nginx 无效

# ---- 1) 补 MIME（本地 OCR 依赖）----
AddType application/wasm          .wasm
AddType application/octet-stream  .traineddata
AddType image/webp                .webp

# ---- 2) 传输压缩：只压文本，不压已压缩的二进制 ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
  # .gz 语言包本身已压缩，二次编码会让 Tesseract 解析失败
  <FilesMatch "\.gz$">
    RemoveOutputFilter DEFLATE
  </FilesMatch>
</IfModule>

# ---- 3) 缓存策略：入口文件必须回源校验，静态资源长期缓存 ----
<IfModule mod_headers.c>
  Header set Vary "Accept-Encoding"

  <FilesMatch "index\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
  </FilesMatch>

  <FilesMatch "\.(webp|jpg|jpeg|png|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- 4) 兜底：不存在的静态资源返回 404，不要回落成 index.html ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/(img|ocr)/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# ---- 5) 内部数据与配置文件禁止公网直接读取 ----
# data/ 下是账号存档、PIN 摘要、限流与审计日志；备份 / 配置 / 脚本同理，一律不给外部读。
<IfModule mod_authz_core.c>
  <FilesMatch "\.(json|log|py|toml|conf|md|sql|bak|ini)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(json|log|py|toml|conf|md|sql|bak|ini)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^data/ - [F,L]
</IfModule>